generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums -----------------------------------------------------------------

enum UserRole {
  owner
  admin
  technician
}

enum InspectionStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum InspectionItemResult {
  pass
  fail
  na
  pending
}

enum ReportStatus {
  draft
  generating
  finalized
  failed
}

enum RecurrenceInterval {
  monthly
  quarterly
  annual
}

enum BuildingType {
  commercial
  residential
  industrial
  mixed
  other
}

/// Building-level compliance derived from inspection activity (synced on inspection changes).
enum ComplianceStatus {
  PASS
  FAIL
  PENDING
  OVERDUE
}

enum QuoteStatus {
  draft
  sent
  accepted
  declined
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

// --- Core tenant -----------------------------------------------------------

/// Fire inspection company (tenant).
model Company {
  id            String  @id @default(cuid())
  name          String
  /// HTTPS URL or data URL for PDF report header.
  logoUrl       String?
  reportEmail   String?
  reportPhone   String?
  reportAddress String? @db.Text

  /// App-managed free trial end (14 days from company creation for new tenants).
  trialEndsAt          DateTime?
  subscriptionStatus   SubscriptionStatus @default(trialing)
  paddleCustomerId     String?
  paddleSubscriptionId String?            @unique
  subscriptionRenewsAt DateTime?

  users           User[]
  customers       Customer[]
  inspectionTypes InspectionType[]
  inspections     Inspection[]
  quotes          Quote[]
  auditEvents     AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

/// Staff member linked to Clerk; belongs to one company.
model User {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Clerk user id (`user_...`) — unique per company.
  clerkUserId String
  email       String?
  name        String?
  role        UserRole
  active      Boolean   @default(true)
  deletedAt   DateTime?

  inspectionsAssigned Inspection[] @relation("InspectionAssignee")
  auditEvents         AuditEvent[] @relation("AuditEventActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, clerkUserId])
  @@index([companyId])
  @@map("users")
}

/// Building owner / client of the inspection company.
model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?

  buildings Building[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("customers")
}

/// Physical site inspected (belongs to a customer).
model Building {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Display name, e.g. "Main Office", "Warehouse A".
  name         String?
  /// Street address (primary line).
  addressLine1 String
  addressLine2 String?
  city         String
  /// State / province.
  region       String
  /// ZIP / postal code.
  postalCode   String
  country      String  @default("US")

  buildingType BuildingType?
  /// Fire district or AHJ jurisdiction.
  fireDistrict String?
  /// General site notes (free text).
  notes        String?       @map("generalNotes") @db.Text

  /// Denormalized from inspections; updated via syncBuildingComplianceStatus.
  currentStatus ComplianceStatus @default(PENDING)

  inspections   Inspection[]
  buildingNotes BuildingNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([currentStatus])
  @@map("buildings")
}

/// Timestamped note on a building (site history).
model BuildingNote {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  body       String  @db.Text
  authorName String?

  createdAt DateTime @default(now())

  @@index([buildingId])
  @@map("building_notes")
}

/// Cadence category (e.g. annual, quarterly, monthly) — per company so labels can vary.
model InspectionType {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Stable code: `annual`, `quarterly`, `monthly`, or custom.
  code String
  name String

  inspections Inspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@map("inspection_types")
}

/// Scheduled or completed inspection visit for one building.
model Inspection {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  inspectionTypeId String
  inspectionType   InspectionType @relation(fields: [inspectionTypeId], references: [id], onDelete: Restrict)

  /// Technician (or lead) assigned to perform the inspection.
  assignedToUserId String?
  assignedTo       User?   @relation("InspectionAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  scheduledAt DateTime
  completedAt DateTime?
  status      InspectionStatus @default(scheduled)

  notes String? @db.Text

  /// Digital signature captured at submit (PNG data URL).
  signatureData     String?   @db.Text
  signedAt          DateTime?
  submittedByUserId String?

  /// Shared id for inspections created as one recurring series.
  recurrenceGroupId  String?
  recurrenceInterval RecurrenceInterval?

  items   InspectionItem[]
  /// Photos captured during this inspection (also reachable from Building via inspections).
  photos  Photo[]
  /// PDF reports for this inspection (also reachable from Building via inspections).
  reports Report[]
  /// Repair estimate created from failed inspection items.
  quote   Quote?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([buildingId])
  @@index([assignedToUserId])
  @@index([scheduledAt])
  @@index([recurrenceGroupId])
  @@map("inspections")
}

/// Single checklist row for an inspection (pass / fail / N/A).
model InspectionItem {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  label       String
  description String? @db.Text
  sortOrder   Int     @default(0)

  result InspectionItemResult @default(pending)
  notes  String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionId])
  @@map("inspection_items")
}

/// Image captured during an inspection (storage path or public URL).
model Photo {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  url       String /// Supabase Storage public HTTPS URL (legacy rows may be data URLs)
  caption   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionId])
  @@map("photos")
}

/// Generated inspection report (PDF).
model Report {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  title       String?
  storageUrl  String /// bucket path or URL to PDF
  status      ReportStatus @default(draft)
  generatedAt DateTime?

  /// Set when the compliance PDF is emailed to the customer after submit.
  emailedTo  String?
  emailedAt  DateTime?
  emailError String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionId])
  @@map("reports")
}

/// Repair estimate derived from failed inspection items.
model Quote {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inspectionId String     @unique
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  status QuoteStatus @default(draft)
  title  String?
  notes  String?     @db.Text

  currency           String @default("USD")
  subtotalCents      Int    @default(0)
  /// Percentage in basis points (10000 = 100.00%).
  taxRateBasisPoints Int    @default(0)
  taxCents           Int    @default(0)
  discountCents      Int    @default(0)
  totalCents         Int    @default(0)

  sentTo          String?
  sentAt          DateTime?
  sentMessageId   String?
  statusChangedAt DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?

  lineItems QuoteLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@map("quotes")
}

model QuoteLineItem {
  id String @id @default(cuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  label          String
  description    String? @db.Text
  quantity       Int     @default(1)
  unitPriceCents Int     @default(0)
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@map("quote_line_items")
}

/// Append-only audit trail for important actions within a company.
model AuditEvent {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Optional actor (staff user) who triggered the event.
  actorUserId String?
  actor       User?   @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  entityType String?
  entityId   String?

  /// Optional structured context for debugging/auditing.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}
