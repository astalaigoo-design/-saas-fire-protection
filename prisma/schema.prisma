generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Connection URLs: required on Prisma 6; in Prisma 7 they move to prisma.config.ts only.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums -----------------------------------------------------------------

enum UserRole {
  owner
  admin
  technician
}

enum InspectionStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum InspectionItemResult {
  pass
  fail
  na
  pending
}

enum ReportStatus {
  draft
  generating
  finalized
  failed
}

enum RecurrenceInterval {
  monthly
  quarterly
  annual
}

enum BuildingType {
  commercial
  residential
  industrial
  mixed
  other
}

/// Equipment on a building site (extinguishers, panels, etc.).
enum AssetType {
  fire_extinguisher
  fire_alarm_panel
  sprinkler_component
  fire_hydrant
  standpipe
  emergency_light
  hose_cabinet
  other
}

/// Building-level compliance derived from inspection activity (synced on inspection changes).
enum ComplianceStatus {
  PASS
  FAIL
  PENDING
  OVERDUE
}

enum QuoteStatus {
  draft
  sent
  accepted
  declined
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

/// Corrective-action lifecycle for a failed checklist item.
enum CustomerContactRole {
  billing
  site
}

enum DeficiencyStatus {
  open
  owned
  resolved
  verified
}

/// Field repair / service ticket — not an NFPA inspection visit.
enum WorkOrderStatus {
  draft
  scheduled
  in_progress
  completed
  cancelled
}

/// Outbound integration events (CMMS / accounting webhooks).
enum IntegrationWebhookEvent {
  inspection_completed
  report_finalized
  quote_updated
  deficiency_created
}

// --- Core tenant -----------------------------------------------------------

/// Fire inspection company (tenant).
model Company {
  id            String  @id @default(cuid())
  name          String
  /// HTTPS URL or data URL for PDF report header.
  logoUrl       String?
  reportEmail   String?
  reportPhone   String?
  reportAddress String? @db.Text

  /// App-managed free trial end (14 days from company creation for new tenants).
  trialEndsAt          DateTime?
  subscriptionStatus   SubscriptionStatus @default(trialing)
  paddleCustomerId     String?
  paddleSubscriptionId String?            @unique
  subscriptionRenewsAt DateTime?

  /// Pilot design partner — complimentary access; Paddle checkout hidden for this tenant.
  designPartner Boolean @default(false)

  /// Default prefix when a building has no jurisdiction-specific sequence.
  certificateNumberPrefix String?
  nextCertificateNumber   Int     @default(1)

  users           User[]
  jurisdictions   Jurisdiction[]
  reports         Report[]
  branches        Branch[]
  customers       Customer[]
  inspectionTypes InspectionType[]
  inspections     Inspection[]
  quotes          Quote[]
  auditEvents         AuditEvent[]
  staffNotifications  StaffNotification[]
  deficiencies        Deficiency[]
  parts               Part[]
  workOrders          WorkOrder[]
  apiKeys             CompanyApiKey[]
  webhookEndpoints    CompanyWebhookEndpoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

/// Normalized AHJ / fire district for certificate numbering and PDF form templates.
model Jurisdiction {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String
  /// Short code unique per company (exports, certificate prefix).
  code String
  /// Prepended to certificate numbers for this AHJ, e.g. `AFD-`.
  certificatePrefix     String?
  nextCertificateNumber Int     @default(1)
  /// React-PDF template key: `default`, `nfpa25-sprinkler`, `nfpa72-alarm`.
  reportTemplateKey String @default("default")

  buildings Building[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("jurisdictions")
}

/// Company-scoped API key for read-only REST (`/api/v1/*`).
model CompanyApiKey {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  label     String  @default("API key")
  /// First segment shown in UI, e.g. `ff_live_ab12`.
  keyPrefix String
  keyHash   String  @unique
  active    Boolean @default(true)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("company_api_keys")
}

/// HTTPS endpoint that receives signed outbound webhooks for a company.
model CompanyWebhookEndpoint {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  label  String  @default("Webhook")
  url    String
  /// HMAC secret (shown once on create); used for `X-Flareflow-Signature`.
  secret String
  events IntegrationWebhookEvent[]
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("company_webhook_endpoints")
}

/// Office / region under a company; customers belong to one branch.
model Branch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)
  /// When CSV omits the branch column, use this branch (one per company recommended).
  isImportDefault Boolean @default(false)
  /// Default equipment type for manual add and imports missing asset_type.
  defaultAssetType AssetType?
  /// Months added to last service (or today) when next_service_due is omitted on import.
  defaultServiceIntervalMonths Int?

  customers Customer[]
  users     User[]
  assetServiceIntervals BranchAssetServiceInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("branches")
}

/// Per-branch test/service interval in months for a specific equipment type.
model BranchAssetServiceInterval {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assetType AssetType
  intervalMonths Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, assetType])
  @@index([branchId])
  @@map("branch_asset_service_intervals")
}

/// Staff member linked to Clerk; belongs to one company.
model User {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Clerk user id (`user_...`) — unique per company.
  clerkUserId String
  email       String?
  /// E.164 preferred, e.g. +15551234567 — used for technician job SMS (Twilio).
  phone       String?
  name        String?
  role        UserRole
  active      Boolean   @default(true)
  deletedAt   DateTime?

  /// Null for owners (company-wide). Admins and technicians belong to one branch via this FK — no join table.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  inspectionsAssigned     Inspection[]            @relation("InspectionAssignee")
  deficienciesAssigned    Deficiency[]            @relation("DeficiencyAssignee")
  workOrdersAssigned      WorkOrder[]             @relation("WorkOrderAssignee")
  auditEvents             AuditEvent[]            @relation("AuditEventActor")
  staffNotificationReads  StaffNotificationRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, clerkUserId])
  @@index([companyId])
  @@index([branchId])
  @@map("users")
}

/// Building owner / client of the inspection company.
model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?

  /// Secret link for read-only customer portal (reports & sites).
  portalToken     String?   @unique
  portalEnabledAt DateTime?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  buildings Building[]
  contacts  CustomerContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@map("customers")
}

/// Billing or on-site contact for a customer account.
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?
  role  CustomerContactRole
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, role])
  @@map("customer_contacts")
}

/// Physical site inspected (belongs to a customer).
model Building {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Display name, e.g. "Main Office", "Warehouse A".
  name         String?
  /// Street address (primary line).
  addressLine1 String
  addressLine2 String?
  city         String
  /// State / province.
  region       String
  /// ZIP / postal code.
  postalCode   String
  country      String  @default("US")

  buildingType BuildingType?
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  /// Fire district or AHJ jurisdiction (free text; synced from jurisdiction when set).
  fireDistrict String?
  /// AHJ permit or system approval identifier.
  permitNumber   String?
  permitExpiresAt DateTime?
  /// General site notes (free text).
  notes        String?       @map("generalNotes") @db.Text

  /// Denormalized from inspections; updated via syncBuildingComplianceStatus.
  currentStatus ComplianceStatus @default(PENDING)

  inspections   Inspection[]
  buildingNotes BuildingNote[]
  deficiencies  Deficiency[]
  assets        BuildingAsset[]
  workOrders    WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([currentStatus])
  @@index([jurisdictionId])
  @@map("buildings")
}

/// Registered fire equipment at a building (extinguisher tags, panels, last service).
model BuildingAsset {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  assetType AssetType
  /// Extinguisher tag / asset ID on site.
  tagNumber String?
  /// Raw QR/barcode payload on the physical label (often same as tagNumber).
  barcodeValue String?
  /// Where on site (floor, room, panel location).
  location  String
  manufacturer String?
  model        String?
  serialNumber String?
  lastServiceAt  DateTime?
  nextServiceDue DateTime?
  notes          String?   @db.Text
  active         Boolean   @default(true)
  retiredAt      DateTime?

  inspectionChecks InspectionAssetCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buildingId, active])
  @@map("building_assets")
}

/// Technician result for one register item during a field inspection.
model InspectionAssetCheck {
  id             String     @id @default(cuid())
  inspectionId   String
  inspection     Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  buildingAssetId String
  buildingAsset  BuildingAsset @relation(fields: [buildingAssetId], references: [id], onDelete: Cascade)

  result    InspectionItemResult @default(pending)
  notes     String?              @db.Text
  /// Set on submit when marked pass — also stamps BuildingAsset.lastServiceAt.
  servicedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inspectionId, buildingAssetId])
  @@index([inspectionId])
  @@index([buildingAssetId])
  @@map("inspection_asset_checks")
}

/// Timestamped note on a building (site history).
model BuildingNote {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  body       String  @db.Text
  authorName String?

  createdAt DateTime @default(now())

  @@index([buildingId])
  @@map("building_notes")
}

/// Cadence category (e.g. annual, quarterly, monthly) — per company so labels can vary.
model InspectionType {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Stable code: `annual`, `quarterly`, `monthly`, or custom.
  code String
  name String

  inspections            Inspection[]
  checklistTemplateItems ChecklistTemplateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@map("inspection_types")
}

/// Owner-editable checklist rows copied onto new inspections for this inspection type.
model ChecklistTemplateItem {
  id               String         @id @default(cuid())
  inspectionTypeId String
  inspectionType   InspectionType @relation(fields: [inspectionTypeId], references: [id], onDelete: Cascade)

  label       String
  description String? @db.Text
  sortOrder   Int     @default(0)
  /// When set, a passing checklist row stamps the register item with this tag on submit.
  linkedTagNumber String?
  /// Hidden items are omitted when scheduling new jobs (existing inspections unchanged).
  hidden      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionTypeId])
  @@map("checklist_template_items")
}

/// Scheduled or completed inspection visit for one building.
model Inspection {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  inspectionTypeId String
  inspectionType   InspectionType @relation(fields: [inspectionTypeId], references: [id], onDelete: Restrict)

  /// Technician (or lead) assigned to perform the inspection.
  assignedToUserId String?
  assignedTo       User?   @relation("InspectionAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  scheduledAt DateTime
  /// First time the visit moved to in_progress (check-in or form open).
  startedAt   DateTime?
  /// GPS check-in timestamp (explicit on-site arrival).
  arrivedAt   DateTime?
  arrivalLatitude        Float?
  arrivalLongitude       Float?
  arrivalAccuracyMeters  Float?
  completedAt DateTime?
  submitLatitude        Float?
  submitLongitude       Float?
  submitAccuracyMeters  Float?
  /// Round-trip or one-way miles logged by technician at submit.
  mileageMiles Float?
  status      InspectionStatus @default(scheduled)

  /// Set when the day-of technician SMS cron successfully sends (one per job per day).
  technicianDayOfSmsSentAt DateTime?

  notes String? @db.Text

  /// Digital signature captured at submit (PNG data URL).
  signatureData     String?   @db.Text
  signedAt          DateTime?
  submittedByUserId String?

  /// Shared id for inspections created as one recurring series.
  recurrenceGroupId  String?
  recurrenceInterval RecurrenceInterval?

  items   InspectionItem[]
  /// Photos captured during this inspection (also reachable from Building via inspections).
  photos  Photo[]
  /// PDF reports for this inspection (also reachable from Building via inspections).
  reports Report[]
  /// Repair estimate created from failed inspection items.
  quote   Quote?
  /// Job scheduled after the customer accepted the repair quote.
  scheduledForQuote Quote? @relation("QuoteScheduledJob")

  deficienciesOpened   Deficiency[] @relation("DeficiencySourceInspection")
  deficienciesVerified Deficiency[] @relation("DeficiencyVerifiedInspection")

  /// Per-asset pass/fail and service stamp for this visit (building equipment register).
  assetChecks InspectionAssetCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([buildingId])
  @@index([assignedToUserId])
  @@index([scheduledAt])
  @@index([recurrenceGroupId])
  @@map("inspections")
}

/// Single checklist row for an inspection (pass / fail / N/A).
model InspectionItem {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  label       String
  description String? @db.Text
  sortOrder   Int     @default(0)
  /// Copied from template when the job is scheduled; links pass to register by tag.
  linkedTagNumber String?

  result InspectionItemResult @default(pending)
  notes  String?              @db.Text

  deficiency Deficiency?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionId])
  @@map("inspection_items")
}

/// Open violation / corrective action tracked across visits for one building.
model Deficiency {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  inspectionItemId String         @unique
  inspectionItem   InspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)

  sourceInspectionId String
  sourceInspection   Inspection @relation("DeficiencySourceInspection", fields: [sourceInspectionId], references: [id], onDelete: Cascade)

  label       String
  description String? @db.Text
  notes       String? @db.Text

  status DeficiencyStatus @default(open)

  dueAt DateTime?

  assignedToUserId String?
  assignedTo       User?   @relation("DeficiencyAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  resolvedNote String? @db.Text

  verifiedAt             DateTime?
  verifiedInspectionId   String?
  verifiedInspection     Inspection? @relation("DeficiencyVerifiedInspection", fields: [verifiedInspectionId], references: [id], onDelete: SetNull)

  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([buildingId, status])
  @@index([assignedToUserId])
  @@map("deficiencies")
}

/// Image captured during an inspection (storage path or public URL).
model Photo {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  url       String /// Supabase Storage public HTTPS URL (legacy rows may be data URLs)
  caption   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionId])
  @@map("photos")
}

/// Generated inspection report (PDF).
model Report {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title       String?
  storageUrl  String /// bucket path or URL to PDF
  status      ReportStatus @default(draft)
  generatedAt DateTime?

  /// Human-readable certificate number (company- or jurisdiction-scoped sequence).
  certificateNumber String?
  /// React-PDF template used when finalized.
  reportTemplateKey String?

  /// Unguessable token for customer read-only report access at /r/[token].
  shareToken String? @unique

  /// Set when the compliance PDF is emailed to the customer after submit.
  emailedTo  String?
  emailedAt  DateTime?
  emailError String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, certificateNumber])
  @@index([inspectionId])
  @@index([companyId])
  @@map("reports")
}

/// Repair estimate derived from failed inspection items.
model Quote {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inspectionId String     @unique
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  status QuoteStatus @default(draft)
  title  String?
  notes  String?     @db.Text

  currency           String @default("USD")
  subtotalCents      Int    @default(0)
  /// Percentage in basis points (10000 = 100.00%).
  taxRateBasisPoints Int    @default(0)
  taxCents           Int    @default(0)
  discountCents      Int    @default(0)
  totalCents         Int    @default(0)

  sentTo          String?
  sentAt          DateTime?
  sentMessageId   String?
  statusChangedAt DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?

  /// Unguessable token for customer read-only quote access at /q/[token].
  shareToken String? @unique

  /// Follow-up inspection visit created from this accepted quote.
  scheduledInspectionId String?     @unique
  scheduledInspection   Inspection? @relation("QuoteScheduledJob", fields: [scheduledInspectionId], references: [id], onDelete: SetNull)

  lineItems QuoteLineItem[]
  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@map("quotes")
}

/// Company parts catalog (stock on hand for field repairs).
model Part {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sku             String
  name            String
  description     String? @db.Text
  unitCents       Int     @default(0)
  quantityOnHand  Int     @default(0)
  active          Boolean @default(true)

  workOrderLines WorkOrderPartLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId, active])
  @@map("parts")
}

/// Repair or service work at a building — separate from inspections.
model WorkOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  status      WorkOrderStatus @default(draft)

  deficiencyId String?
  deficiency   Deficiency? @relation(fields: [deficiencyId], references: [id], onDelete: SetNull)

  quoteId String?
  quote   Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  assignedToUserId String?
  assignedTo       User? @relation("WorkOrderAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?   @db.Text

  partLines WorkOrderPartLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([buildingId])
  @@index([assignedToUserId])
  @@index([scheduledAt])
  @@map("work_orders")
}

/// Parts consumed or planned on a work order (catalog or ad-hoc line).
model WorkOrderPartLine {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  partId String?
  part   Part? @relation(fields: [partId], references: [id], onDelete: SetNull)

  label          String
  quantity       Int @default(1)
  unitCents      Int @default(0)
  sortOrder      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
  @@map("work_order_part_lines")
}

model QuoteLineItem {
  id String @id @default(cuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  label          String
  description    String? @db.Text
  quantity       Int     @default(1)
  unitPriceCents Int     @default(0)
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@map("quote_line_items")
}

/// Append-only audit trail for important actions within a company.
model AuditEvent {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Optional actor (staff user) who triggered the event.
  actorUserId String?
  actor       User?   @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  entityType String?
  entityId   String?

  /// Optional structured context for debugging/auditing.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

/// In-app alert for owners, admins, and (when targeted) assigned technicians.
model StaffNotification {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// e.g. quote.accepted, inspection.assigned, report.email_failed
  type String

  title String
  body  String @db.Text

  href       String?
  entityType String?
  entityId   String?

  /// Null = company-wide for owners/admins; set for assignee-only alerts.
  targetUserId String?

  reads StaffNotificationRead[]

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, targetUserId, createdAt])
  @@map("staff_notifications")
}

model StaffNotificationRead {
  id             String            @id @default(cuid())
  notificationId String
  notification   StaffNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime          @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("staff_notification_reads")
}

/// Durable idempotency cache for serverless/offline replays.
model IdempotencyKey {
  id String @id @default(cuid())

  /// Globally unique key derived from route + client idempotency key.
  cacheKey String @unique

  method String?
  path   String?

  /// Optional fingerprint of request body (to detect key reuse with different payload).
  requestHash String?

  status Int
  body   Json

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}
