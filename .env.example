# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Public site URL for customer report links in emails (production: https://getflareflow.com)
# NEXT_PUBLIC_APP_URL=https://getflareflow.com

# --- Clerk (https://dashboard.clerk.com → API Keys) ---
# Publishable key: pk_test_... or pk_live_... → NEXT_PUBLIC_* only
# Secret key: sk_test_... or sk_live_... → CLERK_SECRET_KEY only (never swap)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Roles (Clerk Dashboard → Users → Public metadata):
# { "role": "owner" | "admin" | "technician", "companyId": "<cuid>" }
#
# --- Clerk webhooks (production user provisioning) ---
# Dashboard → Webhooks → Add endpoint → https://your-domain/api/webhooks/clerk
# Subscribe to: user.created, user.updated, user.deleted
# Copy signing secret:
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Self-serve sign-ups without companyId in public metadata get a new isolated company.
# To add a user to an existing tenant, set Clerk public metadata before or after sign-up:
# { "role": "owner" | "admin" | "technician", "companyId": "<cuid>" }
# Do not set CLERK_DEFAULT_COMPANY_ID in production — it caused new users to see demo data.
# Shared demo / pilot workspace — self-serve users are migrated off this on first login:
# SHARED_TENANT_COMPANY_ID=cmpc93rk30000tkngtmv98mra
# Optional extra emails allowed on the shared demo (defaults: astalaigoo + yuri.joseph19):
# SHARED_TENANT_OPERATOR_EMAILS=astalaigoo@gmail.com,yuri.joseph19@gmail.com
# SHARED_TENANT_OPERATOR_CLERK_IDS=user_xxx,user_yyy

# --- Supabase (Dashboard → Project Settings → Database / Connect → URI) ---
# Reference ID → use as postgres.[PROJECT-REF] in pooler URLs (not on direct db.* user)
# Same database password on both lines below.
# P1000 or `npm run db:test` code 28P01 → Database → Reset database password, update .env, retry.
# On Windows, use Session pooler for DIRECT_URL (db.* is often IPv6-only → P1001).

# Transaction pooler (port 6543) — app runtime + Prisma Client
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Session pooler (port 5432) — Prisma migrate deploy / baseline (required on Vercel Production)
# One-time production baseline: npm run db:baseline-migrations -- --verify --yes
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Example region host: aws-1-us-east-1.pooler.supabase.com (copy exact host from your dashboard)

# --- Supabase Storage (inspection photos) ---
# Dashboard → Project Settings → API → Project URL + service_role key (never expose service_role to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public bucket for field photos (create once: node scripts/ensure-inspection-photos-bucket.mjs)
SUPABASE_STORAGE_BUCKET=inspection-photos

# --- PDF reports (optional — set on Company in Prisma Studio) ---
# logoUrl: HTTPS image URL for compliance PDF header
# reportEmail, reportPhone, reportAddress: shown on generated reports

# --- Outbound email — Resend only (https://resend.com) ---
# Gates ALL operational mail: compliance PDFs, quotes, due/trial crons, staff alerts, technician jobs.
# Set on Vercel Production (and anywhere crons run). Owners see status under Organization → Outbound email.
# REPORT_EMAIL_FROM must use a verified domain in Resend (e.g. reports@yourdomain.com)
# RESEND_API_KEY=re_...
# REPORT_EMAIL_FROM="GetFlareflow <reports@getflareflow.com>"

# --- Technician SMS (Twilio) ---
# Assign/reschedule SMS + daily day-of texts for jobs scheduled today (cron /api/cron/technician-day-of).
# Technicians save mobile on My jobs; owners can set it under Organization → Team.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+15551234567

# --- Recurring inspection automation (Vercel Cron) ---
# Daily job sends "Building X due in 7 days" to each company's report email / owners.
# Generate a random secret and add the same value in Vercel → Settings → Cron / env:
# Design partner (complimentary pilot — set via scripts/mark-design-partner.ts):
#   npx tsx scripts/mark-design-partner.ts <companyId>

# CRON_SECRET=your-long-random-secret
# Cron routes (Authorization: Bearer <CRON_SECRET>):
#   GET /api/cron/technician-day-of — SMS technicians jobs scheduled today
#   GET /api/cron/due-reminders — inspection due in 7 days
#   GET /api/cron/trial-ending-reminders — trial ending in 7 days and 1 day (owners)

# --- Seed (optional — npm run db:seed) ---
# Clerk user IDs from Dashboard → Users (link app User rows to Clerk)
# SEED_CLERK_OWNER_ID=user_
# SEED_CLERK_ADMIN_ID=user_
# SEED_CLERK_TECHNICIAN_ID=user_

# Link your Clerk account after sign-up (sets role + companyId in Clerk public metadata):
# npm run fix-user -- user_xxx owner
# FIX_CLERK_USER_ID=user_
# FIX_USER_ROLE=owner
# FIX_COMPANY_ID=                           # optional; defaults to user's company or demo tenant

# --- Rate limits (middleware — public PDFs + webhooks) ---
# Public report/quote PDF: per IP (default 30/min). Webhooks: global per endpoint (300/min).
# Uses in-memory buckets locally; set Upstash on Vercel for distributed limits across instances.
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# RATE_LIMIT_PUBLIC_PDF_PER_MIN=30
# RATE_LIMIT_WEBHOOK_CLERK_PER_MIN=300
# RATE_LIMIT_WEBHOOK_PADDLE_PER_MIN=300
# RATE_LIMIT_DISABLED=1

# --- Error monitoring (Sentry — https://sentry.io) ---
# Create a Next.js project; set DSN on server and browser (can be the same value).
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional: SENTRY_ENVIRONMENT=production (defaults to VERCEL_ENV or NODE_ENV)
# Optional: SENTRY_TRACES_SAMPLE_RATE=0.1
# Source maps on Vercel build (optional):
# SENTRY_ORG=your-org
# SENTRY_PROJECT=getflareflow
# SENTRY_AUTH_TOKEN=sntrys_...
# Vercel → Project → Monitoring also provides runtime errors when Sentry is linked.

# --- Billing (Paddle) ---
# Client-side token (Paddle → Developer tools → Authentication → Client-side tokens).
# Production tokens start with live_; sandbox with test_. Safe for NEXT_PUBLIC_* (browser).
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxxxxxxxxx
# Product ID (Paddle → Catalog → Products) — reference only; checkout uses price ID.
# NEXT_PUBLIC_PADDLE_PRODUCT_ID=pro_xxxxxxxxxxxxxxxxxxxxxxxx
# Price ID for Paddle.js inline checkout on /dashboard/billing (Paddle → Catalog → Prices).
# NEXT_PUBLIC_PADDLE_PRICE_ID=pri_xxxxxxxxxxxxxxxxxxxxxxxx
# Hosted checkout URL from Paddle → Checkout links. The app appends user_email and
# custom_data={"company_id":"..."} automatically for webhook linking.
# NEXT_PUBLIC_PADDLE_CHECKOUT_URL=https://pay.paddle.io/checkout/YOUR_CHECKOUT_ID?price_id=YOUR_PRICE_ID
# Optional customer portal homepage (fallback when API session cannot be created):
# NEXT_PUBLIC_PADDLE_CUSTOMER_PORTAL_URL=https://customer-portal.paddle.com/cpl_xxxxxxxx
# Server API key for authenticated portal links (cancel / update card). Paddle → Developer tools →
# Authentication → API keys — permission: customer_portal_session.write
# PADDLE_API_KEY=pdl_live_apikey_xxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxx_xxx
# Webhook: Paddle → Notifications → https://your-domain/api/webhooks/paddle
# Events: subscription.created, subscription.updated, subscription.canceled, subscription.paused,
#         subscription.activated, subscription.resumed, subscription.past_due, transaction.payment_failed
# PADDLE_WEBHOOK_SECRET=your-notification-signing-secret

# --- Marketing demo videos (homepage hero + clip cards) ---
# Optional: YouTube, Vimeo, or site path. If unset, uses public/marketing/demo/hero-field-inspection.webm when present.
# NEXT_PUBLIC_MARKETING_HERO_VIDEO_URL=/marketing/demo/hero-field-inspection.webm
# NEXT_PUBLIC_MARKETING_CLIP_FIELD_URL=
# NEXT_PUBLIC_MARKETING_CLIP_REPORT_URL=
# NEXT_PUBLIC_MARKETING_CLIP_QUOTE_URL=
# Record bundled hero: npm run marketing:demo-video (dev server required). See docs/marketing/DEMO-VIDEOS.md.
