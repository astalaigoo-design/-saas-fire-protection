CLERK_SECRET_KEY="sk_test_..."

# Supabase — copy BOTH strings from Dashboard → Connect → URI (same database password)
# Project ref: Settings → General → Reference ID → use as postgres.[PROJECT-REF]
# P1000 = wrong password or wrong project ref → Database → Reset database password

# Transaction pooler (6543) — runtime / Prisma Client
DATABASE_URL="postgresql://postgres.zdghesdcavpjinsocsmt:y4Y4MUb6MybAjDJB@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Session pooler (5432) — prisma db push / migrate (prefer over db.* on Windows; direct host is often IPv6-only)
DIRECT_URL="postgresql://postgres.zdghesdcavpjinsocsmt:y4Y4MUb6MybAjDJB@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
