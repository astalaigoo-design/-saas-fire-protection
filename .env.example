# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Clerk (https://dashboard.clerk.com → API Keys) ---
# Publishable key: pk_test_... or pk_live_... → NEXT_PUBLIC_* only
# Secret key: sk_test_... or sk_live_... → CLERK_SECRET_KEY only (never swap)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Roles (Clerk Dashboard → Users → Public metadata):
# { "role": "owner" | "admin" | "technician", "companyId": "<cuid>" }
#
# --- Clerk webhooks (production user provisioning) ---
# Dashboard → Webhooks → Add endpoint → https://your-domain/api/webhooks/clerk
# Subscribe to: user.created, user.updated, user.deleted
# Copy signing secret:
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Self-serve sign-ups without companyId in public metadata get a new isolated company.
# To add a user to an existing tenant, set Clerk public metadata before or after sign-up:
# { "role": "owner" | "admin" | "technician", "companyId": "<cuid>" }
# Do not set CLERK_DEFAULT_COMPANY_ID in production — it caused new users to see demo data.
# Shared demo / pilot workspace — self-serve users are migrated off this on first login:
# SHARED_TENANT_COMPANY_ID=cmpc93rk30000tkngtmv98mra
# Optional extra emails allowed on the shared demo (defaults: astalaigoo + yuri.joseph19):
# SHARED_TENANT_OPERATOR_EMAILS=astalaigoo@gmail.com,yuri.joseph19@gmail.com
# SHARED_TENANT_OPERATOR_CLERK_IDS=user_xxx,user_yyy

# --- Supabase (Dashboard → Project Settings → Database / Connect → URI) ---
# Reference ID → use as postgres.[PROJECT-REF] in pooler URLs (not on direct db.* user)
# Same database password on both lines below.
# P1000 or `npm run db:test` code 28P01 → Database → Reset database password, update .env, retry.
# On Windows, use Session pooler for DIRECT_URL (db.* is often IPv6-only → P1001).

# Transaction pooler (port 6543) — app runtime + Prisma Client
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Session pooler (port 5432) — npx prisma db push / migrate dev
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Example region host: aws-1-us-east-1.pooler.supabase.com (copy exact host from your dashboard)

# --- Supabase Storage (inspection photos) ---
# Dashboard → Project Settings → API → Project URL + service_role key (never expose service_role to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public bucket for field photos (create once: node scripts/ensure-inspection-photos-bucket.mjs)
SUPABASE_STORAGE_BUCKET=inspection-photos

# --- PDF reports (optional — set on Company in Prisma Studio) ---
# logoUrl: HTTPS image URL for compliance PDF header
# reportEmail, reportPhone, reportAddress: shown on generated reports

# --- Post-submit report email (Resend — https://resend.com) ---
# After a technician submits an inspection, the compliance PDF is emailed to the customer.
# REPORT_EMAIL_FROM must use a verified domain in Resend (e.g. reports@yourdomain.com)
# RESEND_API_KEY=re_...
# REPORT_EMAIL_FROM="GetFlareflow <reports@getflareflow.com>"

# --- Recurring inspection automation (Vercel Cron) ---
# Daily job sends "Building X due in 7 days" to each company's report email / owners.
# Generate a random secret and add the same value in Vercel → Settings → Cron / env:
# CRON_SECRET=your-long-random-secret
# Cron route: GET /api/cron/due-reminders (Authorization: Bearer <CRON_SECRET>)

# --- Seed (optional — npm run db:seed) ---
# Clerk user IDs from Dashboard → Users (link app User rows to Clerk)
# SEED_CLERK_OWNER_ID=user_
# SEED_CLERK_ADMIN_ID=user_
# SEED_CLERK_TECHNICIAN_ID=user_

# Link your Clerk account after sign-up (sets role + companyId in Clerk public metadata):
# npm run fix-user -- user_xxx owner
# FIX_CLERK_USER_ID=user_
# FIX_USER_ROLE=owner
# FIX_COMPANY_ID=                           # optional; defaults to user's company or demo tenant

# --- Billing (Paddle) ---
# Hosted checkout URL from Paddle → Checkout links. The app appends user_email and
# custom_data={"company_id":"..."} automatically for webhook linking.
# NEXT_PUBLIC_PADDLE_CHECKOUT_URL=https://pay.paddle.io/checkout/YOUR_CHECKOUT_ID?price_id=YOUR_PRICE_ID
# Optional customer portal for manage/cancel subscription:
# NEXT_PUBLIC_PADDLE_CUSTOMER_PORTAL_URL=https://customer-portal.paddle.com/YOUR_PORTAL_LINK
# Webhook: Paddle → Notifications → https://your-domain/api/webhooks/paddle
# Events: subscription.created, subscription.updated, subscription.canceled, subscription.paused,
#         subscription.activated, subscription.resumed, subscription.past_due, transaction.payment_failed
# PADDLE_WEBHOOK_SECRET=your-notification-signing-secret
