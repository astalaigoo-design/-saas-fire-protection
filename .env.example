# Clerk (https://dashboard.clerk.com → API Keys)
# Publishable key starts with pk_test_ or pk_live_ — use ONLY for NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
# Secret key starts with sk_test_ or sk_live_ — use ONLY for CLERK_SECRET_KEY. Do not swap them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Roles (per user): Clerk Dashboard → Users → select user → Public metadata
# Example: { "role": "owner" }  — allowed values: owner | admin | technician

# Copy to ".env" and paste values from Supabase:
# Dashboard → Project Settings → Database → Connection string

# Pooled (Transaction pooler, port 6543) — app + Prisma Client
# User is often `postgres.<project-ref>`. Add &connection_limit=1 for Prisma + PgBouncer.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations — use whichever string Supabase labels for Session / Direct (port 5432):
# Typical direct host:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# If your dashboard uses the pooler host on 5432 instead, use that URI here (same password).
