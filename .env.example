# Copy to ".env" and fill in values from Supabase:
# Dashboard → your project → Project Settings → Database

# Pooled connection (Transaction pooler / port 6543) — use for the app + Prisma Client.
# Supabase UI: "Connection string" → URI → set mode to "Transaction" if offered.
# Append for Prisma + PgBouncer: ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — use for prisma migrate / db push / introspection.
# Supabase UI: "Connection string" → Session mode or "Direct connection".
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
