{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/vercel-build.mjs",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.getflareflow.com" }],
      "destination": "https://getflareflow.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/due-reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
